# Database (Railway provides DATABASE_URL when you add PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Server (Railway sets PORT automatically)
PORT=5001
NODE_ENV=production

# Email (optional — omit SMTP vars to skip email in dev)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@atomquest.dev

# Frontend URL for CORS / email links (your Railway frontend service URL)
FRONTEND_URL=http://localhost:5173

# Dev role switching (set false in production)
ADMIN_DEV_MODE=true
